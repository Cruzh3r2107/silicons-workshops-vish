#!/bin/sh
# kernel-build-debs: build and validate Ubuntu kernel Debian packages.
set -eu
: "${PROJECT_DIR:=/project}"
SDK_DIR=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
. "$PROJECT_DIR/lib/common/common.sh"
. "$PROJECT_DIR/lib/common/ubuntu-kernel.sh"
. "$SDK_DIR/lib/debs.sh"
debs_main "$@"
