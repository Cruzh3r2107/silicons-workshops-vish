#!/bin/bash
set -euo pipefail
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
	fakeroot dpkg-dev python3 python3-yaml

# Put the SDK's public command on PATH (this Workshop release does not run
# setup-sdk hooks).
ln -sf "$SDK/bin/kernel-build-debs" /usr/local/bin/kernel-build-debs
