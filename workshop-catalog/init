#!/usr/bin/env bash
# workshop-catalog init
#
# Initializes a Silicon Workshop Catalog in the current directory.
# Run this from your project root after cloning canonical/silicon-workshops.
#
# Usage:
#   cd /path/to/your/project
#   /path/to/canonical/silicon-workshops/workshop-catalog/init
#
# What it does:
#   1. Copies workshop-template/ into your project
#   2. Installs the create-workshop Copilot skill
#   3. Creates catalog.yaml if it doesn't exist
#   4. Prints next steps
#
# Requirements:
#   - Git (for cloning kernel sources later)
#   - GitHub Copilot in VS Code agent mode (the skill runs in Copilot chat)
#   - The 'workshop' snap: sudo snap install workshop --classic

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLKIT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
TARGET_DIR="${PWD}"

echo ""
echo "  Silicon Workshop Catalog — init"
echo "  ================================"
echo "  Target: ${TARGET_DIR}"
echo ""

# --- Check we're not running inside the silicon-workshops repo itself ---
if [[ "${TARGET_DIR}" == "${TOOLKIT_ROOT}" ]]; then
  echo "Error: Run this from your project directory, not from inside silicon-workshops." >&2
  echo "  cd /path/to/your/project" >&2
  echo "  ${BASH_SOURCE[0]}" >&2
  exit 1
fi

# --- 1. Copy workshop-template/ ---
if [[ -d "${TARGET_DIR}/workshop-template" ]]; then
  echo "  ✓ workshop-template/ already present — skipping copy."
else
  cp -r "${TOOLKIT_ROOT}/workshop-template" "${TARGET_DIR}/workshop-template"
  echo "  ✓ Copied workshop-template/"
fi

# --- 2. Install create-workshop Copilot skill ---
SKILL_SRC="${TOOLKIT_ROOT}/workshop-catalog/skills/create-workshop/SKILL.md"
SKILL_DST="${TARGET_DIR}/.github/skills/create-workshop/SKILL.md"
if [[ -f "${SKILL_DST}" ]]; then
  echo "  ✓ create-workshop skill already present — skipping."
else
  mkdir -p "$(dirname "${SKILL_DST}")"
  cp "${SKILL_SRC}" "${SKILL_DST}"
  echo "  ✓ Installed .github/skills/create-workshop/SKILL.md"
fi

# --- 3. Create catalog.yaml if missing ---
CATALOG="${TARGET_DIR}/catalog.yaml"
if [[ -f "${CATALOG}" ]]; then
  echo "  ✓ catalog.yaml already present — skipping."
else
  cat > "${CATALOG}" << 'EOF'
# Silicon Workshop Catalog
# Machine-readable index of Silicon Workshops in this catalog.
# Managed automatically by the create-workshop skill.
#
# To add a workshop: use the create-workshop skill in Copilot chat.

schema_version: 1

workshops: []
EOF
  echo "  ✓ Created catalog.yaml"
fi

# --- Done ---
echo ""
echo "  Done. Next steps:"
echo ""
echo "    1. Open this directory in VS Code with GitHub Copilot enabled."
echo "    2. In Copilot chat, type: create-workshop"
echo "    3. Follow the guided prompts to create your first Silicon Workshop."
echo ""
echo "  The skill will:"
echo "    - Guide you through vendor / Ubuntu release / EVK selection"
echo "    - Resolve the correct kernel tag from Launchpad automatically"
echo "    - Generate a ready-to-launch workshop directory"
echo ""
